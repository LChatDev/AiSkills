{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Example private record",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "updatedAt",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object"
    }
  }
}
